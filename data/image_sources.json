{
  "schema_version": 9,
  "department_id": "aura3",
  "enabled": true,
  "provider": "STOCK_MEDIA_GOVERNED",
  "sources": [
    {
      "id": "pexels",
      "type": "pexels",
      "enabled": true,
      "priority": 1,
      "endpoint": "https://api.pexels.com/v1/search",
      "credential_env": "PEXELS_API_KEY",
      "license": "Pexels License",
      "license_url": "https://www.pexels.com/license/",
      "page_size": 40,
      "max_requests_per_run": 8,
      "timeout_seconds": 15,
      "http_retry_attempts": 3
    },
    {
      "id": "pixabay",
      "type": "pixabay",
      "enabled": true,
      "priority": 2,
      "endpoint": "https://pixabay.com/api/",
      "credential_env": "PIXABAY_API_KEY",
      "license": "Pixabay Content License",
      "license_url": "https://pixabay.com/service/license-summary/",
      "page_size": 40,
      "max_requests_per_run": 8,
      "timeout_seconds": 15,
      "http_retry_attempts": 3
    },
    {
      "id": "unsplash",
      "type": "unsplash",
      "enabled": true,
      "priority": 3,
      "endpoint": "https://api.unsplash.com/search/photos",
      "credential_env": "UNSPLASH_ACCESS_KEY",
      "license": "Unsplash License",
      "license_url": "https://unsplash.com/license",
      "page_size": 30,
      "max_requests_per_run": 8,
      "timeout_seconds": 15,
      "http_retry_attempts": 3
    }
  ],
  "search_terms": [
    {"photo_tag":"office","query":"modern office interior workspace","angle":"current office planning, workspace efficiency and turnkey execution"},
    {"photo_tag":"office","query":"contemporary corporate office interior","angle":"current corporate workspace planning, finishes and turnkey execution"},
    {"photo_tag":"workspace","query":"modern coworking office interior","angle":"current flexible workspace planning, density and collaboration"},
    {"photo_tag":"workspace","query":"open plan office interior desks","angle":"current open-office density, circulation and productivity planning"},
    {"photo_tag":"meeting","query":"modern conference room interior","angle":"current meeting-room planning, acoustics, lighting and coordination"},
    {"photo_tag":"meeting","query":"modern boardroom interior","angle":"current boardroom planning, AV, acoustics and executive meeting experience"},
    {"photo_tag":"reception","query":"modern office reception lobby interior","angle":"current reception design, first impression and material planning"},
    {"photo_tag":"commercial","query":"modern commercial interior fitout","angle":"current commercial fit-out scope, budget control and project delivery"},
    {"photo_tag":"hospitality","query":"contemporary hotel lobby interior","angle":"current hospitality finishes, lighting and guest-experience execution"},
    {"photo_tag":"retail","query":"contemporary retail store interior","angle":"current retail layout, customer flow and fast-track fit-out"}
  ],
  "metadata_prefilter": {
    "enabled": true,
    "positive_tokens": ["office","workspace","workplace","cowork","conference","meeting","boardroom","reception","lobby","hotel","retail","store","commercial","interior","desk","furniture","room"],
    "negative_tokens": ["map","atlas","painting","engraving","illustration","poster","manuscript","archive","archival","historic","historical","heritage","museum object","floor plan","blueprint","drawing","postcard","lithograph"]
  },
  "allowed_source_licenses": ["Pexels License", "Pixabay Content License", "Unsplash License"],
  "allowed_mime_types": ["image/jpeg", "image/png", "image/webp"],
  "min_width": 1200,
  "min_height": 800,
  "max_search_requests_per_run": 24,
  "max_new_items_per_run": 40,
  "target_fresh_pool_items": 80,
  "max_pool_items": 120,
  "minimum_sanitized_pool_items": 25,
  "adaptive_refresh_passes": 2,
  "timeout_seconds": 15,
  "perceptual_dedupe": {
    "enabled": true,
    "algorithm": "dhash64",
    "max_hamming_distance": 4,
    "max_hash_downloads_per_run": 50,
    "timeout_seconds": 10,
    "fail_open_if_hash_unavailable": true
  },
  "user_agent": "AURA3-VisualAcquisition/9.0 (Design Infra governed content system)",
  "commercial_use_policy": "SOURCE_LICENSE_COMMERCIAL_USE_REQUIRED",
  "image_validation_rulebook": "governance/image_validation_rulebook.json",
  "design_freshness_policy": "CURRENT_OR_RELEVANT_OLDER_VISUAL_LANGUAGE_ALLOWED_NO_VINTAGE_OR_DATED_INTERIORS",
  "confidential_data_upload": false,
  "truth_note": "Active visual sourcing is restricted to Pexels, Pixabay and Unsplash. Each candidate preserves source page, source identifier, author, source-specific license name and license URL. Canonical URL plus perceptual-hash dedupe remains active. Metadata filtering is only an admission prefilter; mandatory actual-image DeepSeek/Nova validation remains authoritative for current-design suitability, quality and Founder-queue eligibility. No Founder or publish authority is delegated to image sources."
}
