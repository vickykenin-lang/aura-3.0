{
  "schema_version": 2,
  "department_id": "aura3",
  "baseline_id": "HF_BASELINE_V1",
  "enabled": false,
  "mode": "SHADOW_ONLY",
  "production_authority": false,
  "required_for_business_execution": false,
  "primary_model": "siglip_primary",
  "secondary_models": ["blip_caption_candidate"],
  "execution": {
    "backend": "local_transformers",
    "python_version": "3.12.14",
    "torch_version": "2.14.0+cpu",
    "timeout_seconds": 30,
    "transient_retries": 1,
    "retry_delay_seconds": 1,
    "retryable_classes": ["network", "hub_download", "temporary_runtime"],
    "circuit_breaker": {
      "failure_threshold": 3,
      "cooldown_seconds": 900
    },
    "production_shadow_boundary": "SEPARATE_GITHUB_ACTIONS_JOB",
    "max_job_minutes": 30,
    "max_cases_per_run": 10,
    "gpu_allowed": false,
    "dedicated_endpoint_allowed": false
  },
  "image_policy": {
    "https_only": true,
    "max_image_bytes": 8388608,
    "allowed_mime_types": ["image/jpeg", "image/png", "image/webp"]
  },
  "security": {
    "allow_remote_code": false,
    "prefer_safetensors": true,
    "require_safetensors_for_primary": true,
    "token_env": "HF_AURA3_EVAL_TOKEN",
    "token_required_for_public_models": false,
    "write_token_required": false,
    "inject_hf_token_for_public_primary": false,
    "upload_to_hub_allowed": false,
    "public_dataset_upload_allowed": false,
    "checkout_persist_credentials": false
  },
  "cost_policy": {
    "hf_hosted_paid_inference_allowed": false,
    "hf_dedicated_endpoint_allowed": false,
    "phase1_5_external_spend_ceiling_usd": 2.0,
    "current_hf_hosted_inference_spend_usd": 0.0,
    "github_actions_compute_attribution": "NOT_ATTRIBUTED",
    "new_paid_commitment_requires_founder_approval": true
  },
  "data_policy": {
    "confidential_client_data_allowed": false,
    "lead_or_contact_data_allowed": false,
    "public_reference_images_allowed": true,
    "synthetic_test_data_allowed": true
  },
  "rollback": {
    "primary_switch": "HF_EVALUATION_ENABLED=false",
    "config_equivalent": "enabled=false",
    "requires_database_rollback": false,
    "requires_provider_replacement": false,
    "restores_existing_path": "Gemini -> DeepSeek -> AURA3 governance"
  },
  "truth_rule": "HF output is shadow evidence only and cannot approve, reject, publish, alter production routing, or establish a business outcome."
}
